<?xml version="1.0" encoding="UTF-8"?>

<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/processdef">

    <process id="approvalWorkflow" name="Approval Workflow" isExecutable="true">

        <startEvent id="startEvent"/>
        <sequenceFlow id="flow1" sourceRef="startEvent" targetRef="approvalTask"/>

        <!-- APPROVAL TASK -->
        <userTask id="approvalTask" name="${currentApproval}" flowable:candidateGroups="${approvalRole}"/>

        <!-- FIRST REMINDER -->
        <boundaryEvent id="firstReminderTimer"
                       attachedToRef="approvalTask"
                       cancelActivity="false">

            <timerEventDefinition>
                <timeDuration>${reminderDuration}</timeDuration>
            </timerEventDefinition>

        </boundaryEvent>

        <serviceTask id="sendReminderTask"
                     name="Send Reminder"
                     flowable:delegateExpression="${reminderDelegate}"/>

        <sequenceFlow id="reminderFlow1"
                      sourceRef="firstReminderTimer"
                      targetRef="sendReminderTask"/>

        <!-- SECOND REMINDER -->
        <boundaryEvent id="secondReminderTimer"
                       attachedToRef="approvalTask"
                       cancelActivity="false">

            <timerEventDefinition>
                <timeDuration>${secondReminderDuration}</timeDuration>
            </timerEventDefinition>

        </boundaryEvent>

        <serviceTask id="sendSecondReminderTask"
                     name="Send Second Reminder"
                     flowable:delegateExpression="${reminderDelegate}"/>

        <sequenceFlow id="reminderFlow2"
                      sourceRef="secondReminderTimer"
                      targetRef="sendSecondReminderTask"/>

        <!-- ESCALATION -->
        <boundaryEvent id="escalationTimer"
                       attachedToRef="approvalTask"
                       cancelActivity="false">

            <timerEventDefinition>
                <timeDuration>${escalationDuration}</timeDuration>
            </timerEventDefinition>

        </boundaryEvent>

        <serviceTask id="escalationTask"
                     name="Escalate Workflow"
                     flowable:delegateExpression="${escalationDelegate}"/>

        <sequenceFlow id="escalationFlow"
                      sourceRef="escalationTimer"
                      targetRef="escalationTask"/>

        <!-- APPROVE / REJECT -->
        <sequenceFlow id="flow2"
                      sourceRef="approvalTask"
                      targetRef="approvalDecision"/>

        <exclusiveGateway id="approvalDecision"/>

        <!-- APPROVE -->

        <sequenceFlow id="approveFlow"
                      sourceRef="approvalDecision"
                      targetRef="checkNextLevel">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${approved == true}]]>
            </conditionExpression>

        </sequenceFlow>

        <!-- REJECT -->

        <sequenceFlow id="rejectFlow"
                      sourceRef="approvalDecision"
                      targetRef="requesterTask">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${approved == false}]]>
            </conditionExpression>

        </sequenceFlow>

        <!-- NEXT LEVEL -->
        <serviceTask id="checkNextLevel"
                     name="Check Next Level"
                     flowable:delegateExpression="${approvalLevelDelegate}"/>

        <sequenceFlow id="flow3"
                      sourceRef="checkNextLevel"
                      targetRef="hasNextLevelGateway"/>

        <exclusiveGateway id="hasNextLevelGateway"/>

        <sequenceFlow id="flow4"
                      sourceRef="hasNextLevelGateway"
                      targetRef="approvalTask">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${hasNextLevel == true}]]>
            </conditionExpression>

        </sequenceFlow>

        <sequenceFlow id="flow5"
                      sourceRef="hasNextLevelGateway"
                      targetRef="approvedEnd">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${hasNextLevel == false}]]>
            </conditionExpression>

        </sequenceFlow>

        <!-- REQUESTER CORRECTION -->
        <userTask id="requesterTask"
                  name="Requester Correction"
                  flowable:candidateGroups="${requestedRole}"/>

        <sequenceFlow id="flow6"
                      sourceRef="requesterTask"
                      targetRef="resubmitGateway"/>

        <!-- RESUBMIT -->
        <exclusiveGateway id="resubmitGateway"/>

        <sequenceFlow id="resubmitFlow"
                      sourceRef="resubmitGateway"
                      targetRef="resubmissionTask">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${resubmitted == true}]]>
            </conditionExpression>

        </sequenceFlow>

        <sequenceFlow id="cancelFlow"
                      sourceRef="resubmitGateway"
                      targetRef="rejectedEnd">

            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${resubmitted == false}]]>
            </conditionExpression>

        </sequenceFlow>

        <!-- RESUBMISSION -->
        <serviceTask id="resubmissionTask"
                     name="Prepare Resubmission"
                     flowable:delegateExpression="${resubmissionDelegate}"/>

        <sequenceFlow id="flow7"
                      sourceRef="resubmissionTask"
                      targetRef="approvalTask"/>

        <!-- END EVENTS -->
        <endEvent id="approvedEnd"/>
        <endEvent id="rejectedEnd"/>

    </process>
</definitions>
