      "name": "University Trainee Management",
      "item": [
        {
          "name": "Create University Trainee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.environment.set('trainee_id', jsonData.data.id);",
                  "        console.log('✓ Trainee ID saved:', jsonData.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"genderId\": 1,\n  \"age\": 25,\n  \"phone\": \"201001234567\",\n  \"email\": \"john.doe@example.com\",\n  \"paymentMethodId\": 1,\n  \"universityId\": 1,\n  \"semester\": \"Fall 2024\",\n  \"faculty\": \"Engineering\",\n  \"regionId\": 1,\n  \"districtId\": 1,\n  \"cityId\": 1,\n  \"photoUrl\": \"https://example.com/photo.jpg\",\n  \"statusId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/hr/university-trainees/save",
              "host": ["{{base_url}}"],
              "path": ["api", "hr", "university-trainees", "save"]
            },
            "description": "Creates a new university trainee record. The response includes the newly created trainee ID which is automatically saved to 'trainee_id'.\n\nRequired Fields:\n- fullName: String (max 120 chars)\n- genderId: Long\n- age: Short (17-60)\n- phone: String (9-15 digits only)\n- email: String (valid email format)\n- paymentMethodId: Long\n- universityId: Long\n- semester: String (max 50 chars)\n- faculty: String (max 100 chars)\n- regionId: Long\n- districtId: Long\n- cityId: Long\n- statusId: Long\n\nOptional Fields:\n- photoUrl: String (max 500 chars)"
          },
          "response": [
            {
              "name": "Success Response",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Trainee created successfully\",\n  \"data\": {\n    \"id\": 1,\n    \"fullName\": \"John Doe\",\n    \"genderId\": 1,\n    \"age\": 25,\n    \"phone\": \"201001234567\",\n    \"email\": \"john.doe@example.com\",\n    \"paymentMethodId\": 1,\n    \"universityId\": 1,\n    \"semester\": \"Fall 2024\",\n    \"faculty\": \"Engineering\",\n    \"regionId\": 1,\n    \"districtId\": 1,\n    \"cityId\": 1,\n    \"photoUrl\": \"https://example.com/photo.jpg\",\n    \"statusId\": 1,\n    \"isActive\": true,\n    \"createdAt\": \"2026-06-08T10:30:45\",\n    \"createdBy\": null,\n    \"updatedAt\": \"2026-06-08T10:30:45\",\n    \"updatedBy\": null\n  }\n}"
            }
          ]
        },
