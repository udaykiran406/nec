          "name": "Create Portal User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "",
                  "    // validate response status field",
                  "    pm.expect(jsonData.status).to.equal(201);",
                  "",
                  "    // validate message",
                  "    pm.expect(jsonData.message).to.eql(\"Portal user created successfully\");",
                  "",
                  "    // validate data object exists",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "",
                  "    if (jsonData.data && jsonData.data.portalUserId) {",
                  "        pm.environment.set(\"portal_user_id\", jsonData.data.portalUserId);",
                  "        console.log(\"✓ Portal User ID saved:\", jsonData.data.portalUserId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
