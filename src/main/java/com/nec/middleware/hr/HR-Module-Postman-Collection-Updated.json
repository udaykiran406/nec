              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hr",
                "university-trainees"
              ]
            },
            "description": "Creates a new university trainee record. The response includes the newly created trainee ID which is automatically saved to 'universityTraineeId'."
          },
          "response": []
        },
