      "name": "University Trainee Management",
      "item": [
        {
          "name": "Create University Trainee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test(\"Response has success status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.universityTraineeId) {",
                  "        pm.environment.set('universityTraineeId', jsonData.data.universityTraineeId);",
                  "        console.log('\u2713 University Trainee ID saved:', jsonData.data.universityTraineeId);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"genderId\": 1,\n  \"age\": 25,\n  \"phone\": \"201001234567\",\n  \"email\": \"john.doe@example.com\",\n  \"paymentMethodId\": 1,\n  \"universityId\": 1,\n  \"semester\": \"Fall 2024\",\n  \"faculty\": \"Engineering\",\n  \"regionId\": 1,\n  \"districtId\": 1,\n  \"cityId\": 1,\n  \"photoUrl\": \"https://example.com/photo.jpg\",\n  \"statusId\": 1\n}"
            },
