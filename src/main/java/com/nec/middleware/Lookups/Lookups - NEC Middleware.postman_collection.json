    "name": "Lookups - NEC Middleware",
    "description": "Postman collection for Lookup Management APIs in NEC Middleware. Supports retrieving all active lookup tables, fetching values by table name, and adding/editing lookup values dynamically.\n\nLookup table names follow the pattern: nec_lkp_<name>\nExamples: nec_lkp_gender, nec_lkp_roles, nec_lkp_payment_methods, nec_lkp_status, nec_lkp_contract_types",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "50342627",
    "_collection_link": "https://go.postman.co/collection/50342627-7f057d37-2483-46a6-850d-b740be140f96?source=collection_link"
  },
  "item": [
    {
      "name": "Lookup Management",
      "item": [
        {
          "name": "Get All Active Lookup Tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains lookup table list\", function () {",
                  "    var jsonData = pm.response.json();",
                  "",
                  "    pm.expect(jsonData.success).to.equal(true);",
                  "    pm.expect(jsonData.message).to.eql(\"Lookup table names retrieved successfully\");",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        pm.environment.set(\"lookup_table_name\", jsonData.data[0].tableName);",
                  "        console.log(\"✓ First lookup table name saved:\", jsonData.data[0].tableName);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/lookups",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "lookups"
              ]
            },
            "description": "Returns a list of all active lookup table names registered in the system.\n\nResponse shape:\n{\n  \"success\": true,\n  \"message\": \"Lookup table names retrieved successfully\",\n  \"data\": [\n    { \"id\": 1, \"tableName\": \"nec_lkp_gender\", \"isActive\": 1 },\n    { \"id\": 2, \"tableName\": \"nec_lkp_roles\", \"isActive\": 1 }\n  ]\n}\n\nUse the returned tableName values to call the 'Get Lookup Values by Table Name' endpoint."
          },
